# Matto Bayat – Environment Variables

# Site URL (used for Open Graph & canonical alternates)
NEXT_PUBLIC_SITE_URL=https://matto-bayat.vercel.app

# Supabase (optional for development; demo data is used automatically when omitted)
# Supports either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
